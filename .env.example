# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
OPENAI_API_KEY=your-api-key-here
# Use any chat model your account can access (check your OpenAI dashboard).
OPENAI_MODEL=gpt-4o-mini
# Leave blank to omit the temperature setting (some newer models reject it).
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=30
# Optional overrides
DATABASE_PATH=data/students.db
MAX_RESULT_ROWS=100
QUERY_TIMEOUT_SECONDS=5
